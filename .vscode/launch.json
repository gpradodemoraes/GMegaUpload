{
    "version": "0.2.0",
    "defaults": {},
    "configurations": [
        {
            "name": "debug_me",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceRoot}/out/build/DBG_gmegaupload/bin/Debug/gmegaupload.exe",
            "args": [
                "--action",
                "uploadbackup",
                "--directory",
                "${env:TEMP}\\testando",
                "--remote_folder",
                "MEGA",
                "Gabriel",
                "Prado",
                "de",
                "Moraes",
                "sqlitebakup",
                "--files",
                "folha_desconto_de_ferias.png",
                "importacao_arquivo_folha_concluir_processo.png",
                "importacao_arquivo_folha_final.png",
                "importacao_arquivo_folha_selecionar_filial.png",
                "importacao_arquivo_folha.png",
                "boleto_09_07_01.pdf",
                "Apontamentos_da_ConferenciaV.pdf",
                "Palno_de_trabalho_ISA_parte_2026.pdf",
                "Documentos_AAD___Coord_Adm.pdf",
                "--splitsizemegabytes",
                "3",
                "--sufix",
                "FOTOS_GABRIEL"
            ],
            "cwd": "${workspaceRoot}/out/build/DBG_gmegaupload/bin/Debug",
            "console": "externalTerminal"
        },
        {
            "name": "release_me",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceRoot}/out/build/RLS_esqueleto/bin/esqueleto.exe",
            "args": [
                "a",
                "b"
            ],
            "cwd": "${workspaceRoot}/out/build/RLS_esqueleto/bin",
            "console": "externalTerminal"
        }
    ]
}