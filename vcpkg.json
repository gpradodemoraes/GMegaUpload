{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "gmegaupload",
    "homepage": "https://github.com/meganz/sdk",
    "features": {
        "use-openssl": {
            "description": "OpenSSL library",
            "dependencies": [
                "openssl"
            ]
        },
        "use-libuv": {
            "description": "libuv library",
            "dependencies": [
                "libuv"
            ]
        },
        "use-readline": {
            "description": "Readline library",
            "dependencies": [
                "readline"
            ]
        },
        "sdk-tests": {
            "description": "gtests library for the integration and unit tests",
            "dependencies": [ "gtest" ]
        },
        "c-ares-backend-curl": {
            "description": "Enable c-ares backend for curl",
            "dependencies": [
                {
                    "name": "curl",
                    "features": [
                        "c-ares"
                    ]
                }
            ]
        }
    },
    "dependencies": [
        "fmt",
        "cryptopp",
        {
          "name": "curl",
          "features": [ "websockets", "zstd" ]
        },
        "icu",
        "libsodium",
        "sqlite3"
    ],
    "overrides": [
        {
            "name": "icu",
            "version": "74.2#4"
        }
    ]
}
